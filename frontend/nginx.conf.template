# nginx del frontend. Sustituido por envsubst al arrancar (ver docker-entrypoint.sh),
# asi que ${BACKEND_UPSTREAM} y ${NGINX_RESOLVER} llegan del entorno del contenedor.

# Resolver del contenedor, detectado en el entrypoint. En Railway es IPv6 y va
# entre corchetes; en Docker local es 127.0.0.11. NO se hardcodea: hardcodear
# 127.0.0.11 en Railway fue justo lo que rompio la resolucion antes.
#
# `valid=10s` mantiene la IP en cache solo 10s. Al usar una variable en
# proxy_pass, nginx vuelve a preguntar al resolver en cada request, asi que un
# redeploy del backend con IP nueva se sigue solo (sin reiniciar el frontend).
resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
resolver_timeout 5s;

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Host:puerto del backend, sin esquema. Lo arma el entrypoint a partir de
    # BACKEND_URL. La variable es lo que fuerza la resolucion por request.
    set $backend_upstream "${BACKEND_UPSTREAM}";

    # ---------------------------------------------------------------------
    # Proxy al backend.
    #
    # OJO con $request_uri: al usar una variable en proxy_pass, nginx NO hace
    # el reemplazo de prefijo de la forma literal; hay que pasar la URI
    # completa. El backend expone /api/... y /health, y con esto llega igual.
    # ---------------------------------------------------------------------

    location /api/ {
        proxy_pass ${BACKEND_SCHEME}://$backend_upstream$request_uri;
        proxy_http_version 1.1;

        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Conectar rapido: si el upstream no responde, 5s y se dice cual era.
        proxy_connect_timeout 5s;
        # Lectura larga: el sync raspa articulos y llama a la API de YouTube,
        # asi que un POST /sync puede tardar de verdad.
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;

        proxy_intercept_errors on;
        error_page 502 504 = @api_upstream_down;
    }

    # Sustituye el 502/504 generico por uno que dice a quien se intentaba
    # llamar. Es la diferencia entre "no funciona" y "mira esto".
    location @api_upstream_down {
        default_type text/plain;
        return 502 "El frontend no logra hablar con el backend.\nBackend configurado: ${BACKEND_SCHEME}://${BACKEND_UPSTREAM}\nRevisa: (1) que el servicio backend este desplegado y sano, (2) que BACKEND_URL use el host interno correcto (servicio.railway.internal:8000), (3) los logs del backend si el proceso no arranco (por ejemplo, una migracion de Alembic).\n";
    }

    # El frontend hace health-poll a /health (environment.ts quita el sufijo
    # /api), que vive fuera del prefijo y por eso necesita su propia regla.
    location = /health {
        proxy_pass ${BACKEND_SCHEME}://$backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_intercept_errors on;
        error_page 502 504 = @api_upstream_down;
    }

    # ---------------------------------------------------------------------
    # Estaticos de Angular.
    # ---------------------------------------------------------------------

    location / {
        # Rutas de cliente (/feed, /news/:id...). Sin esto, recargar en
        # /news/abc daria 404 porque no existe ese fichero en disco.
        try_files $uri $uri/ /index.html;
    }

    # index.html nunca se cachea: es quien apunta a los bundles con hash. Si se
    # cachea, un deploy nuevo sigue sirviendo los bundles viejos.
    location = /index.html {
        add_header Cache-Control "no-store, must-revalidate";
    }

    # Los bundles llevan hash en el nombre, asi que pueden cachearse para
    # siempre sin riesgo de servir una version antigua.
    location ~* \.(?:js|css|woff2?|png|jpg|jpeg|gif|svg|ico|webp)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
}
