# nginx del frontend. Sustituido por envsubst al arrancar (ver Dockerfile), asi
# que ${BACKEND_URL} llega desde las variables del servicio de Railway.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ---------------------------------------------------------------------
    # Upstream: LITERAL a proposito.
    #
    # La variante con `resolver` + variable (re-resolver en cada peticion) se
    # descarto: 127.0.0.11 no es el DNS de Railway, el nombre del backend no
    # resolvia y cada request tardaba 30s en fallar.
    #
    # Consecuencia de usar el literal: nginx resuelve el nombre UNA vez al
    # arrancar y cachea la IP. Si redespliegas el backend y le asignan otra IP
    # interna, hay que REINICIAR el frontend (una vez, no por request).
    # ---------------------------------------------------------------------

    # ---------------------------------------------------------------------
    # Proxy al backend.
    #
    # OJO con proxy_pass SIN barra final: el backend expone /api/... y
    # /health. Con barra, nginx quitaria el prefijo /api/ de la URI y el
    # backend recibiria /feed en vez de /api/feed (404 en todas).
    # ---------------------------------------------------------------------

    location /api/ {
        # SIN barra final: el backend expone /api/... y /health. Con barra,
        # nginx quitaria el prefijo /api/ y llegaria /feed/stats (404).
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Conectar rapido: si el upstream no responde, 5s y se dice cual era.
        # Un connect-timeout largo convertia un error de configuracion en un
        # cuelgue de 30s sin informacion util.
        proxy_connect_timeout 5s;
        # Lectura larga: el sync raspa articulos y llama a la API de YouTube,
        # asi que un POST /sync puede tardar de verdad.
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;

        proxy_intercept_errors on;
        error_page 502 504 = @api_upstream_down;
    }

    # Sustituye el 502/504 generico por uno que dice a quien se intentaba
    # llamar. Es la diferencia entre "no funciona" y "mira esto" cuando
    # BACKEND_URL apunta al sitio equivocado.
    location @api_upstream_down {
        default_type text/plain;
        return 502 "El frontend no logra hablar con el backend.\nUpstream configurado: ${BACKEND_URL}\nRevisa: (1) que el servicio backend este desplegado y sano, (2) que BACKEND_URL apunte a el y no al frontend, (3) si acabas de redesplegar el backend, reinicia el frontend: nginx cachea la IP del upstream al arrancar.\n";
    }

    # El frontend hace health-poll a /health (environment.ts quita el sufijo
    # /api), que vive fuera del prefijo y por eso necesita su propia regla.
    location = /health {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_intercept_errors on;
        error_page 502 504 = @api_upstream_down;
    }

    # ---------------------------------------------------------------------
    # Estaticos de Angular.
    # ---------------------------------------------------------------------

    location / {
        # Rutas de cliente (/feed, /news/:id...). Sin esto, recargar en
        # /news/abc daria 404 porque no existe ese fichero en disco.
        try_files $uri $uri/ /index.html;
    }

    # index.html nunca se cachea: es quien apunta a los bundles con hash. Si se
    # cachea, un deploy nuevo sigue sirviendo los bundles viejos.
    location = /index.html {
        add_header Cache-Control "no-store, must-revalidate";
    }

    # Los bundles llevan hash en el nombre, asi que pueden cachearse para
    # siempre sin riesgo de servir una version antigua.
    location ~* \.(?:js|css|woff2?|png|jpg|jpeg|gif|svg|ico|webp)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
}