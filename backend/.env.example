# ── Base de datos ──
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/newsradar
SQL_ECHO=false

# ── APIs externas ──
# YouTube Data API v3: https://console.cloud.google.com -> YouTube Data API v3
YOUTUBE_API_KEY=

# GitHub Personal Access Token (sin scope basta, solo lectura).
# SIN token el rate limit es 60 req/h y el sync de READMEs falla; con token,
# 5000 req/h. Crear en: https://github.com/settings/tokens
GITHUB_TOKEN=

# ── App ──
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=["http://localhost:4200"]
LOG_LEVEL=INFO

# ── Sincronizacion ──
# Cada cuanto corre el sync periodico de las tres fuentes (ademas del sync
# diario automatico a las 07:00 UTC).
SYNC_INTERVAL_MINUTES=60